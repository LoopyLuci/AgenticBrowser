# AgenticBrowser environment variables
# Copy to `.env` and fill in real values. Do not commit secrets.

# Backend server
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OPENROUTER_KEY=
OPENAI_KEY=
AGENTIC_LOG_LEVEL=INFO
AGENTIC_LOG_FILE=logs/app.jsonl
AGENTIC_QUEUE_DB=.agentic-queue.db
AGENTIC_STATE_DB=.agentic-state.db

# Test toggles
AGENTIC_TEST_OLLAMA=0
AGENTIC_TEST_OPENROUTER=0
AGENTIC_TEST_OPENAI=0

# Control plane
AGENTIC_CONTROL_SECRET=demo
MESH_CLUSTER_KEY=demo
PORT=8766
AGENTIC_BACKEND=http://localhost:8123

# Hermes control wrapper
AGENTIC_CONTROL_BASE=http://localhost:8766
AGENTIC_BACKEND_BASE=http://127.0.0.1:8123
