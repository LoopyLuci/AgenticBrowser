{
  "name": "agentic-browser",
  "version": "0.1.0",
  "description": "Next-generation agentic browser assistant",
  "private": true,
  "scripts": {
    "backend:dev": "cd agentic-browser-backend && npm run dev",
    "backend:start": "cd agentic-browser-backend && npm run start",
    "control:dev": "cd agentic-browser-control && npm run dev",
    "control:start": "cd agentic-browser-control && npm run start",
    "extension:dev": "cd agentic-browser-extension && npm run dev",
    "extension:build": "cd agentic-browser-extension && npm run build",
    "web:dev": "cd agentic-browser-web-ui && npm run dev",
    "web:build": "cd agentic-browser-web-ui && npm run build",
    "package": "bash scripts/package-extension.sh",
    "dev": "concurrently \"npm run backend:dev\" \"npm run control:dev\"",
    "build": "npm run extension:build && npm run web:build && npm run package"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
